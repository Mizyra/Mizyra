DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/moon_institute
SECRET_KEY=change-me-to-a-strong-secret
ACCESS_TOKEN_EXPIRE_MINUTES=180

# Comma-separated list, no spaces needed but tolerated. Keep dev and
# production origins together here (not hard-coded in main.py).
# Local development:
# CORS_ORIGINS=http://localhost:3000
# Production:
CORS_ORIGINS=http://localhost:3000,https://mizyra.org,https://www.mizyra.org

# Contact form -> Excel storage (see app/excel_store.py)
# Relative paths are resolved against the backend/ directory.
CONTACTS_EXCEL_PATH=contacts.xlsx
# Timezone used for the "Date & Time" column. Mizyra is based in Chennai,
# Tamil Nadu, so submissions are timestamped in IST by default.
CONTACT_TIMEZONE=Asia/Kolkata
